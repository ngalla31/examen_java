<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../styles/rapports.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gestion_des_presences_des_profs.controllers.RapportController">
    <children>
        <VBox alignment="CENTER" layoutX="20" layoutY="20" spacing="10">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Exportation de données en PDF" />

            <TableView fx:id="table" prefHeight="300" prefWidth="500">
                <columns>
                    <TableColumn fx:id="cId" prefWidth="114.0" text="ID" />
                    <TableColumn fx:id="cDate" prefWidth="107.33334350585938" text="DATE" />
               <TableColumn fx:id="cCours" prefWidth="107.33334350585938" text="COURS" />
               <TableColumn fx:id="cProf" prefWidth="162.6666259765625" text="PROFESSEUR" />
                </columns>
            </TableView>

            <HBox alignment="CENTER" spacing="10">
                <Label text="De :" />
            <DatePicker fx:id="start" prefHeight="30.0" prefWidth="88.0" />
                <Label text="À :" />
            <DatePicker fx:id="end" prefHeight="30.0" prefWidth="81.0" />
                <Button fx:id="exportToPDF" onAction="#exportToPDF" text="Exporter en PDF" />
            </HBox>
        </VBox>
      <Button fx:id="btRechercher" layoutX="116.0" layoutY="416.0" mnemonicParsing="false" onAction="#rechercher" text="Rechercher" />
    </children>
</AnchorPane>
