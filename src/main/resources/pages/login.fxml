<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../styles/login.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/19" fx:controller="com.example.gestion_des_presences_des_profs.controllers.LoginController">


    <VBox alignment="CENTER" layoutX="100" layoutY="80" prefHeight="400" prefWidth="450" spacing="15" styleClass="container">
        <Label style="-fx-font-size: 20px; -fx-text-fill: white;" text="Connexion" />
        <TextField fx:id="usernameField" promptText="Nom d'utilisateur" styleClass="text-field" />
        <PasswordField fx:id="passwordField" promptText="Mot de passe" styleClass="password-field" />
        <Button fx:id="btLog" onAction="#handleLogin" styleClass="button" text="Se connecter" />
        <Hyperlink onAction="#handleForgotPassword" styleClass="hyperlink" text="Mot de passe oublié ?" />
    </VBox>
</AnchorPane>
