<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.cell.PropertyValueFactory?>
<AnchorPane prefHeight="460.0" prefWidth="625.0" stylesheets="@../styles/notifications.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gestion_des_presences_des_profs.controllers.NotificationsController">
    <children>
        <!-- Titre -->
        <Label layoutX="208.0" layoutY="23.0" text="Notifications">
            <font>
                <Font name="System Bold Italic" size="16.0" />
            </font>
        </Label>

        <!-- TableView pour afficher les notifications -->
        <TableView fx:id="notificationTable" layoutX="71.0" layoutY="70.0" prefHeight="300.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="messageColumn" text="Message" prefWidth="200.0">
                    <cellValueFactory>
                        <PropertyValueFactory property="message"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="destinataireColumn" text="Destinataire" prefWidth="150.0">
                    <cellValueFactory>
                        <PropertyValueFactory property="destinataire"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="dateEnvoiColumn" text="Date de  l'Envoi" prefWidth="180.0">
                    <cellValueFactory>
                        <PropertyValueFactory property="dateEnvoi"/>
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>
    </children>
</AnchorPane>
